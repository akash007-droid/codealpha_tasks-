# ============================================================
# 14. DETECT MAIN UNEMPLOYMENT COLUMN
# ============================================================

def find_column(df, possible_names):

    for name in possible_names:

        if name in df.columns:
            return name

    # Partial matching
    for column in df.columns:

        column_lower = column.lower()

        for name in possible_names:

            if name.lower() in column_lower:
                return column

    return None


unemployment_column_1 = find_column(
    df1,
    [
        "Estimated Unemployment Rate (%)",
        "Unemployment Rate",
        "Unemployment_Rate"
    ]
)

unemployment_column_2 = find_column(
    df2,
    [
        "Estimated Unemployment Rate (%)",
        "Unemployment Rate",
        "Unemployment_Rate"
    ]
)

