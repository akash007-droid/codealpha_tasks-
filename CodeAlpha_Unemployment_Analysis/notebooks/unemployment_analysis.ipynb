# 13. SHOW UNIQUE STATES
# ============================================================

def find_state_column(df):

    possible_names = [
        "Region",
        "State",
        "state",
        "region"
    ]

    for name in possible_names:

        if name in df.columns:
            return name

    return None


state_column_1 = find_state_column(df1)
state_column_2 = find_state_column(df2)

